MAX_UPLOAD_MB=20
# Optional row/column caps. The public beta lowers these on the host; the
# defaults below match the local Docker workspace.
# MAX_UPLOAD_ROWS=100000
# MAX_UPLOAD_COLUMNS=200
# Optional analysis budget in rows x columns. 0 disables it. The public beta
# uses this to reject an oversized file before profiling it.
# MAX_WORKFLOW_CELLS=0
# Optional total storage budget in MB for stored snapshots. 0 disables it.
# The public beta uses this to protect the host disk.
# MAX_STORAGE_MB=0
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Public deployments must set this to true. If sign-in is not fully configured,
# protected APIs then fail closed with 503 instead of running anonymously.
REQUIRE_AUTH=false
# Configure both values to require verified sign-in before data APIs are accessible.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_SIGN_IN_ENABLED=false
# Google OAuth client ID/secret belong in the Supabase Google provider dashboard,
# never in this app's browser bundle or this file. See docs/google-account-setup.md.
MAX_ACCOUNT_FILES=100
MAX_ACCOUNT_STORAGE_MB=1024
MAX_STORED_FILES=1000
# Comma-separated verified account emails permitted to view usage counts.
ADMIN_EMAILS=
# Signed read-only review links. When unset, a private key is generated and kept
# beside the storage directory (never in source control).
# SHARE_SIGNING_KEY=
# Optional bring-your-own-key AI assistant. Set to false to turn it off entirely.
AI_ASSIST_ENABLED=true
# Excel add-in companion only: per-installation token required on /api/addin/*.
# Leave unset on the hosted web app; companion scripts generate it.
# ADDIN_TOKEN=
# Native development: set these in the corresponding process.
# STORAGE_DIR=storage
# API_INTERNAL_URL=http://127.0.0.1:8000
